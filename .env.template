# Copy to .env and fill in. Never commit .env. Values reach the pod only as exported variables in
# the SSH session (scripts/pod.sh env); they must not appear in configs, logs, or task sandboxes.
# RunPod access is through the RunPod MCP plugin (browser sign-in); no RunPod API key is stored.
MODAL_TOKEN_ID=            # optional; Docker sandboxes on the GPU node are the default
MODAL_TOKEN_SECRET=
WANDB_API_KEY=
WANDB_ENTITY=
WANDB_PROJECT=auditbench-uplift
HF_TOKEN=
# Local path to the AuditBench checkout (commit 369ad441f2876245d0db19990c77ccbcb74a0a3a)
AUDITBENCH_DIR=../auditlogsbench
# Pod SSH endpoint, written by the operator after create-pod (not secret)
POD_SSH_HOST=
POD_SSH_PORT=22
POD_SSH_KEY=~/.ssh/auditbench_runpod
