# Copy to .env and fill in. Never commit .env. SkyPilot injects these with `--env-file .env`; they must
# not appear in configs, logs, or task sandboxes.
MODAL_TOKEN_ID=            # optional; Docker sandboxes on the GPU node are the default
MODAL_TOKEN_SECRET=
WANDB_API_KEY=
WANDB_ENTITY=
WANDB_PROJECT=auditbench-uplift
HF_TOKEN=
# Local path to the AuditBench checkout (commit 369ad441f2876245d0db19990c77ccbcb74a0a3a)
AUDITBENCH_DIR=../auditlogsbench
RUNPOD_API_KEY=            # SkyPilot launches the node with it (also ~/.runpod/config.toml); spend guard uses it to stop the pod
