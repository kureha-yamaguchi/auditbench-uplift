# SkyPilot uses this instead of .gitignore. Unlike .gitignore it uploads the generated train/dev tasks (the node cannot
# rebuild them: no AuditBench checkout there) and .git (record_environment.py reads the commit). Test tasks never leave.
.env
.venv/
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
.ruff_cache/
.DS_Store
tasks/test/
runs_local/
jobs/
wandb/
trajectories/*
checkpoints/*
